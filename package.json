{
  "name": "downagain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:prepare": "bun run db:migrate && bun run db:seed && bun run dev:sample && STATUS_FIXTURES_DIR=tests/fixtures bun run poll vercel railway heroku",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun scripts/seed.ts",
    "poll": "bun scripts/poll-once.ts",
    "backfill": "bun scripts/backfill.ts",
    "regrade": "bun scripts/regrade.ts",
    "cron": "bun scripts/cron-trigger.mjs",
    "dev:sample": "bun scripts/dev-sample.ts",
    "ai-review": "bun scripts/ai-review.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "railway": "3.16.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "@parcel/watcher"
  ]
}
