# Postgres (Railway: reference ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:postgres@localhost:5432/downagain

# Shared secret between the poller cron service and the web service
CRON_SECRET=change-me

# Poller cron service only: where to POST (Railway private network)
# POLL_URL=http://downagain.railway.internal:8080/api/cron/poll

# Umami (optional). Script and events are proxied through /stats on our own domain.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=5f60967a-e8ec-4965-85ef-cbcf07e4c968
UMAMI_HOST=https://cloud.umami.is

# Public base URL, used for badges, OG images and the poller User-Agent
NEXT_PUBLIC_SITE_URL=https://downagain.dev
